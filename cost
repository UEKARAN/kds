Organizing Data

import pandas as pd
import numpy as np

df = pd.read_csv('/content/Social_Network_Ads.csv')
print('Original Shape: \n', df.shape, '\n')
df.head()

print('\n information')
print(df.info())

print('\nmissinf values')
print(df.isna().sum())

print('\n duplicate values')
print(df.duplicated().sum())

df.drop_duplicates(inplace=True)

for col in df.columns:
  if df[col].isna().sum() > 0:
    if df[col].dtype == 'object':
      df[col].fillna(df[col].mode()[0], inplace=True)
    else:
      df[col].fillna(df[col].mean(), inplace=True)

df['Gender'] = df['Gender'].str.strip().str.capitalize()

df.rename(columns={
    "EstimatedSalary": "Salary",
    "Purchased": "Purchase_Status"
    }, inplace=True)

df = df[(df['Age'] >=18) &
                      (df['Age'] <=65) &
                      (df['Salary'] >0)]

df['Salary_Band'] =  pd.qcut(df['Salary'] ,q=4,labels=['low','medium','high','very high'])

bins = [18,30,45,65]
labels=['young','Adult','Senior']
df['Age_Category'] = pd.cut(df['Age'],bins=bins,labels=labels, right = False)

df['Gender_Code'] = df['Gender'].replace({'Male': 1, 'Female': 0})

df['Normalized_Salary'] = (
    (df['Salary'] - df ['Salary'].min())/
    (df['Salary'].max() - df['Salary'].min()))

df['Salary_Rank'] = df['Salary'].rank(method='dense',ascending=False)

df.sort_values(
    by=[
        "Age_Category",
        "Salary",
        "Purchase_Status"
    ],
    ascending=[True,False,False],
    inplace=True
)

summary = df.groupby(["Gender", "Age_Category"]).agg(
    Total_Customers=("User ID", "count"),
    Average_Salary=("Salary", "mean"),
    Total_Salary=("Salary", "sum"),
    Max_Salary=("Salary", "max"),
    Min_Salary=("Salary", "min")
)
print("\n Group Summary")
print(summary)

pivot = pd.pivot_table(
    df,
    index="Age_Category",
    columns="Gender",
    values="Salary",
    aggfunc=[
        np.mean,
        np.max,
        np.min
    ]
)
print("\n Pivot Table")
print(pivot,"\n\n")

organized = df.set_index(["Gender", "Age_Category"])
print("\n Organized Dataset \n")
print(organized.head())

Q1 = df['Salary'].quantile(0.25)
Q3 = df['Salary'].quantile(0.75)
IQR = Q3 - Q1
Outliers = df[(df['Salary'] < (Q1 - 1.5 * IQR)) | (df['Salary'] > (Q3 + 1.5 * IQR))]

organized.to_csv("organized_dataset.csv")
summary.to_csv("group_summary.csv")
pivot.to_csv("pivot_table.csv")
Outliers.to_csv("outliers.csv")

print("\n Files Created Successfully \n")
print("1. Organized Dataset: organized_dataset.csv")
print("2. Group Summary: group_summary.csv")
print("3. Pivot Table: pivot_table.csv")
print("4. Outliers: outliers.csv")

