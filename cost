    subprocess.run(
        ["bash", "-lc", "command -v ffmpeg"],
        capture_output=True
    ).returncode
    != 0
):
    subprocess.run(["apt-get", "update", "-qq"], check=True)
    subprocess.run(["apt-get", "install", "-qq", "ffmpeg"], check=True)

# STEP 2: UPLOAD AUDIO FILE

